# Optional provider keys used by the legacy data download scripts.
# Keep real values in your hosting provider's secret/environment settings.
NEWS_API_KEY=
MARKETAUX_API_KEY=
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=

# Optional override for the backend service. Leave unset for the default local
# data directory; the production container sets its persistent volume path.
GOLD_SENTIMENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
